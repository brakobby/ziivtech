---
// ZIIVOS product page: what it is, what's inside, the dashboard at a glance,
// desktop and mobile, then a demo request. Screenshots have customer
// details blurred. Shared layout lives in styles/product.css.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import GetInTouch from '../components/GetInTouch.astro';
import type { IconName } from '../data/icons';
import { ZIIVOS } from '../data/content';
import { SITE, whatsappHref } from '../data/site';
import laptopMockup from '../assets/ziivos/ziivos-laptop-mockup.png';
import dashboard from '../assets/work/ziivos/shots/desktop.png';
import phoneShot from '../assets/work/ziivos/shots/mobile.png';
import '../styles/product.css';

const wa = whatsappHref('Hello ZIIV, I’d like a demo of ZIIVOS.');
---
<BaseLayout title="ZIIVOS" description={ZIIVOS.intro}>
  <section class="prod-hero on-light" aria-labelledby="page-title">
    <div class="prod-hero__text wrap">
      <p class="label">{ZIIVOS.label} · A ZIIV product</p>
      <h1 class="prod-hero__title" id="page-title">{ZIIVOS.title}</h1>
      <p class="lead">{ZIIVOS.intro}</p>
      <div class="prod-hero__actions">
        <Button href={ZIIVOS.demoHref} variant="dark">Request a Demo</Button>
        {SITE.bookingUrl && (
          <Button href={SITE.bookingUrl} variant="outline" target="_blank" rel="noopener noreferrer">
            Book a Call<span class="sr-only"> (opens in a new tab)</span>
          </Button>
        )}
      </div>
    </div>
    <figure class="prod-hero__media prod-hero__media--dark wrap">
      <Image
        src={laptopMockup}
        alt="The ZIIVOS dashboard on a laptop, showing invoicing totals, payment trend and invoice status"
        widths={[640, 960, 1280]}
        sizes="(max-width: 1360px) 92vw, 1280px"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="prod-mods on-light" aria-labelledby="mods-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <p class="label">{ZIIVOS.modules.label}</p>
        <h2 class="display" id="mods-title">{ZIIVOS.modules.title}</h2>
      </header>
      <ul class="prod-mods__grid">
        {ZIIVOS.modules.items.map((m) => (
          <li class="prod-mod">
            <span class="prod-mod__icon"><Icon name={m.icon as IconName} size={20} /></span>
            <h3 class="prod-mod__name">{m.name}</h3>
            <p class="prod-mod__text">{m.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="prod-split section-dark" aria-labelledby="glance-title">
    <div class="prod-split__inner wrap">
      <div class="prod-split__text" data-reveal>
        <p class="label prod-split__label"><Icon name="chart" size={16} /> {ZIIVOS.glance.label}</p>
        <h2 class="display" id="glance-title">{ZIIVOS.glance.title}</h2>
        <p class="lead">{ZIIVOS.glance.text}</p>
        <p class="prod-split__list-label">{ZIIVOS.glance.pointsLabel}</p>
        <ul class="prod-split__list">
          {ZIIVOS.glance.points.map((pt) => <li>{pt}</li>)}
        </ul>
      </div>
      <figure class="prod-split__media" data-reveal>
        <Image
          src={dashboard}
          alt="The ZIIVOS dashboard: totals, invoice status, outstanding breakdown, low stock and top staff"
          widths={[640, 960, 1280]}
          sizes="(max-width: 1024px) 92vw, 680px"
        />
      </figure>
    </div>
  </section>

  <section class="prod-split prod-split--light prod-split--reverse on-light" aria-labelledby="any-title">
    <div class="prod-split__inner wrap">
      <div class="prod-phone" data-reveal>
        <Image
          src={phoneShot}
          alt="The ZIIVOS home screen on a phone, with the business summary"
          widths={[400, 800]}
          sizes="320px"
        />
      </div>
      <div class="prod-split__text" data-reveal>
        <p class="label prod-split__label"><Icon name="devices" size={16} /> {ZIIVOS.anywhere.label}</p>
        <h2 class="display" id="any-title">{ZIIVOS.anywhere.title}</h2>
        <p class="lead">{ZIIVOS.anywhere.text}</p>
      </div>
    </div>
  </section>

  <GetInTouch title={ZIIVOS.cta.title} text={ZIIVOS.cta.text}>
    <Button href={ZIIVOS.demoHref} variant="light">Request a Demo</Button>
    {wa && (
      <Button href={wa} variant="outline-light" target="_blank" rel="noopener noreferrer">
        Ask on WhatsApp<span class="sr-only"> (opens in a new tab)</span>
      </Button>
    )}
  </GetInTouch>
</BaseLayout>
