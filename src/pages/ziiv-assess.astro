---
// ZIIV Assess product page: what it is, what's inside, Code Lab, mobile,
// then a demo request. Copy comes from the CMS (src/cms/assess.json).
// Screenshots have the client school's name blurred; keep it that way.
// Shared layout lives in styles/product.css. The square pattern echoes the
// school portals we build (see SchoolPattern.astro).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import GetInTouch from '../components/GetInTouch.astro';
import SchoolPattern from '../components/SchoolPattern.astro';
import type { IconName } from '../data/icons';
import { ASSESS } from '../data/content';
import { SITE, whatsappHref } from '../data/site';
import dashboard from '../assets/assess/dashboard.png';
import codeLab from '../assets/assess/code-lab.png';
import mobileLessons from '../assets/assess/mobile-lessons.png';
import '../styles/product.css';

const wa = whatsappHref('Hello ZIIV, I’d like a demo of ZIIV Assess.');
---
<BaseLayout title="ZIIV Assess" description={ASSESS.intro}>
  <section class="prod-hero prod-hero--pattern on-light" aria-labelledby="page-title">
    <SchoolPattern tone="light" />
    <div class="prod-hero__text wrap">
      <p class="label">{ASSESS.label} · A ZIIV product</p>
      <h1 class="prod-hero__title" id="page-title">{ASSESS.title}</h1>
      <p class="lead">{ASSESS.intro}</p>
      <div class="prod-hero__actions">
        <Button href={ASSESS.demoHref} variant="dark">Request a Demo</Button>
        {ASSESS.appUrl && (
          <Button href={ASSESS.appUrl} variant="outline" target="_blank" rel="noopener noreferrer">
            Open ZIIV Assess<span class="sr-only"> (opens in a new tab)</span>
          </Button>
        )}
        {SITE.bookingUrl && (
          <Button href={SITE.bookingUrl} variant="outline" target="_blank" rel="noopener noreferrer">
            Book a Call<span class="sr-only"> (opens in a new tab)</span>
          </Button>
        )}
      </div>
    </div>
    <figure class="prod-hero__media wrap">
      <Image
        src={dashboard}
        alt="The ZIIV Assess dashboard: average score, pass rate, submissions, homework completion and score charts"
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 1360px) 92vw, 1280px"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="prod-mods on-light" aria-labelledby="mods-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <p class="label">{ASSESS.modules.label}</p>
        <h2 class="display" id="mods-title">{ASSESS.modules.title}</h2>
      </header>
      <ul class="prod-mods__grid">
        {ASSESS.modules.items.map((m) => (
          <li class="prod-mod">
            <span class="prod-mod__icon"><Icon name={m.icon as IconName} size={20} /></span>
            <h3 class="prod-mod__name">{m.name}</h3>
            <p class="prod-mod__text">{m.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="prod-split prod-split--pattern section-dark" aria-labelledby="code-title">
    <SchoolPattern tone="ziiv" />
    <div class="prod-split__inner wrap">
      <div class="prod-split__text" data-reveal>
        <p class="label prod-split__label"><Icon name="code" size={16} /> {ASSESS.codeLab.label}</p>
        <h2 class="display" id="code-title">{ASSESS.codeLab.title}</h2>
        <p class="lead">{ASSESS.codeLab.text}</p>
        <p class="prod-split__list-label">{ASSESS.codeLab.pointsLabel}</p>
        <ul class="prod-split__list">
          {ASSESS.codeLab.points.map((pt) => <li>{pt}</li>)}
        </ul>
      </div>
      <figure class="prod-split__media" data-reveal>
        <Image
          src={codeLab}
          alt="Code Lab in ZIIV Assess: a Python editor with a Run button and an output panel"
          widths={[640, 960, 1280]}
          sizes="(max-width: 1024px) 92vw, 680px"
        />
      </figure>
    </div>
  </section>

  <section class="prod-split prod-split--light prod-split--reverse on-light" aria-labelledby="any-title">
    <div class="prod-split__inner wrap">
      <div class="prod-phone" data-reveal>
        <Image
          src={mobileLessons}
          alt="Lessons and notes in ZIIV Assess on a phone, with published lessons and progress bars"
          widths={[400, 800]}
          sizes="320px"
        />
      </div>
      <div class="prod-split__text" data-reveal>
        <p class="label prod-split__label"><Icon name="devices" size={16} /> {ASSESS.anywhere.label}</p>
        <h2 class="display" id="any-title">{ASSESS.anywhere.title}</h2>
        <p class="lead">{ASSESS.anywhere.text}</p>
      </div>
    </div>
  </section>

  <GetInTouch title={ASSESS.cta.title} text={ASSESS.cta.text}>
    <Button href={ASSESS.demoHref} variant="light">Request a Demo</Button>
    {wa && (
      <Button href={wa} variant="outline-light" target="_blank" rel="noopener noreferrer">
        Ask on WhatsApp<span class="sr-only"> (opens in a new tab)</span>
      </Button>
    )}
  </GetInTouch>
</BaseLayout>
