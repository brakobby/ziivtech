---
// Who we are: a single statement on deep green, with highlighted phrases.
// On the home page it links to /about.
import Button from './Button.astro';
import { ABOUT } from '../data/content';

interface Props {
  cta?: boolean;
}
const { cta = false } = Astro.props;
---
<section class="about section-dark" aria-labelledby="about-title">
  <div class="about__inner wrap">
    <h2 class="label" id="about-title">{ABOUT.label}</h2>
    <div class="about__body">
      <p class="about__statement" data-reveal>
        {ABOUT.statement.map((seg) => (seg.mark ? <span class="accent">{seg.text}</span> : seg.text))}
      </p>
      {cta && <Button href="/about/" variant="outline-light">More About ZIIV</Button>}
    </div>
  </div>
</section>

<style>
  .about {
    padding: var(--section-y) 0;
  }
  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 2fr);
    gap: clamp(24px, 5vw, 80px);
  }
  .about__inner > .label { padding-top: 0.9em; }
  .about__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(32px, 4vw, 48px);
  }
  .about__statement {
    max-width: 32ch;
    font-family: var(--font-display);
    font-size: clamp(26px, 2.7vw, 40px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .about__inner { grid-template-columns: 1fr; }
    .about__inner > .label { padding-top: 0; }
  }
</style>
