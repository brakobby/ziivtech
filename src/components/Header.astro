---
// One fixed header for every page. Transparent over the opening section,
// it takes a white background and a hairline once the page scrolls
// (scripts/main.ts toggles .is-scrolled). Below 1100px the links move into
// a full-screen menu.
import Logo from './Logo.astro';
import Button from './Button.astro';
import { NAV, CONTACT_HREF } from '../data/site';

// Highlight the section we're in (case studies count as Work).
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => {
  const base = href.replace(/\/$/, '');
  return path === base || path.startsWith(`${base}/`) ? 'page' : undefined;
};
---
<header class="header on-light" id="top" data-header>
  <div class="header__inner wrap">
    <Logo />
    <nav class="header__nav" aria-label="Primary">
      <ul class="header__links">
        {NAV.map((item) => (
          <li><a class="header__link" href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header__end">
      <Button href={CONTACT_HREF} variant="dark" size="sm" arrow={false} class="header__cta">Let’s Talk</Button>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only">Open menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="mobile-menu__top wrap">
    <Logo />
    <button class="mobile-menu__close" type="button" data-menu-close>
      <span class="sr-only">Close menu</span>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <nav class="wrap" aria-label="Mobile">
    <ul class="mobile-menu__links">
      {NAV.map((item) => (
        <li><a class="mobile-menu__link" href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
      ))}
    </ul>
    <Button href={CONTACT_HREF} variant="dark" class="mobile-menu__cta">Let’s Talk</Button>
  </nav>
</div>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: var(--header-h);
    display: flex;
    align-items: center;
    color: var(--ink);
    border-bottom: 1px solid transparent;
    transition: background-color 0.25s, border-color 0.25s, backdrop-filter 0.25s;
  }
  .header.is-scrolled {
    background: rgba(255, 255, 255, 0.88);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .header__links {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.4vw, 36px);
  }
  .header__link {
    position: relative;
    display: block;
    padding: 8px 0;
    color: var(--ink-soft);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .header__link:hover,
  .header__link[aria-current='page'] { color: var(--ink); }
  .header__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 1px;
    background: var(--c-mid);
  }
  .header__end {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* ---------- Menu toggle ---------- */
  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    place-items: center;
  }
  .menu-toggle__bars,
  .menu-toggle__bars::before {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
  }
  .menu-toggle__bars { position: relative; transform: translateY(-3px); }
  .menu-toggle__bars::before {
    content: '';
    position: absolute;
    top: 6px;
  }

  /* ---------- Mobile menu ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 8000;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background: var(--bg-light);
    color: var(--ink);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu.is-open { opacity: 1; }
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
  }
  .mobile-menu__close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    margin-top: 16px;
    border-top: 1px solid var(--line);
  }
  .mobile-menu__link {
    display: block;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: clamp(22px, 6vw, 30px);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .mobile-menu__link[aria-current='page'] { color: var(--c-mid); }
  :global(.mobile-menu__cta) { width: 100%; margin: 28px 0 40px; }

  @media (max-width: 1100px) {
    .header__nav { display: none; }
    .menu-toggle { display: grid; }
  }
  @media (max-width: 520px) {
    :global(.header__cta) { display: none !important; }
  }
</style>
