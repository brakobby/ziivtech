---
// Our values: copy on the left, the values in a ruled two-column list.
import { VALUES } from '../data/content';
---
<section class="values on-light" aria-labelledby="values-title">
  <div class="values__inner wrap">
    <div class="section-head" data-reveal>
      <p class="label">{VALUES.label}</p>
      <h2 class="display" id="values-title">{VALUES.title}</h2>
      <p class="lead">{VALUES.text}</p>
    </div>
    <ul class="values__list">
      {VALUES.items.map((v, i) => (
        <li class="value" data-reveal style={`--reveal-delay: ${(i % 2) * 0.06}s`}>
          <span class="value__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          {v}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .values {
    padding: var(--section-y) 0;
    background: var(--bg-light);
  }
  .values__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
  }
  .values__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 3vw, 40px);
  }
  .value {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: clamp(17px, 1.4vw, 20px);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .value:nth-child(-n + 2) { border-top: 1px solid var(--line); }
  .value__num {
    color: var(--ink-faint);
    font-family: var(--font);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1024px) {
    .values__inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .values__list { grid-template-columns: 1fr; }
    .value:nth-child(2) { border-top: none; }
  }
</style>
