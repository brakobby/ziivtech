---
// Capabilities: heading on the left (sticky on wide screens), a numbered,
// ruled list on the right. `expanded` (Services page) adds each service's
// detail list; the home page version links onward instead.
import Button from './Button.astro';
import { SERVICES } from '../data/content';

interface Props {
  expanded?: boolean;
}
const { expanded = false } = Astro.props;
---
<section class:list={['services on-light', { 'services--expanded': expanded }]} aria-labelledby="services-title">
  <div class="services__inner wrap">
    <header class="services__head">
      <div class="section-head" data-reveal>
        <span class="label">{SERVICES.label}</span>
        <h2 class="display" id="services-title">{SERVICES.title}</h2>
      </div>
      {!expanded && <Button href="/services/" variant="outline">Explore Our Services</Button>}
    </header>

    <ol class="services__list">
      {SERVICES.items.map((s, i) => (
        <li class="service" data-reveal>
          <span class="service__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="service__body">
            <p class="service__category">{s.category}</p>
            <h3 class="service__title">{s.headline}</h3>
            <p class="service__desc">{s.description}</p>
            {expanded && (
              <ul class="service__details">
                {s.details.map((d) => <li>{d}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services {
    padding: var(--section-y) 0;
    background: var(--bg-light);
    color: var(--ink);
  }
  .services__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
  }
  .services__head {
    position: sticky;
    top: calc(var(--header-h) + 40px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  .services__list { border-bottom: 1px solid var(--line); }
  .service {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    padding: clamp(28px, 3vw, 40px) 0;
    border-top: 1px solid var(--line);
  }
  .service__num {
    padding-top: 2px;
    color: var(--ink-faint);
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .service__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .service__category {
    color: var(--ink-accent);
    font-size: 13px;
    font-weight: 600;
  }
  .service__title {
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .service__desc {
    max-width: 54ch;
    color: var(--ink-soft);
  }
  .service__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 28px;
    margin-top: 12px;
    font-size: 15px;
  }
  .service__details li {
    position: relative;
    padding-left: 22px;
  }
  .service__details li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.45em;
    width: 10px;
    height: 6px;
    border-left: 1.5px solid var(--c-mid);
    border-bottom: 1.5px solid var(--c-mid);
    transform: rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .services__inner { grid-template-columns: 1fr; }
    .services__head { position: static; }
  }
  @media (max-width: 600px) {
    .service { grid-template-columns: 1fr; gap: 8px; }
    .service__details { grid-template-columns: 1fr; }
  }
</style>
