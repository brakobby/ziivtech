---
// Capabilities, following the reference's services layout: intro on top,
// brand mark on the left, ruled list on the right. The reference spins a
// 3D logo here; ZIIV keeps its mark flat and draws it with scroll instead.
// `expanded` (Services page) shows every detail list with no toggles;
// the home page version is a compact accordion with a link onward.
import Arrow from './Arrow.astro';
import Button from './Button.astro';
import { SERVICES } from '../data/content';
import { MARK_PARTS, MARK_TRANSFORM, MARK_COLORS } from '../data/brand';

interface Props {
  expanded?: boolean;
}
const { expanded = false } = Astro.props;
---
<section class:list={['services on-light', { 'services--expanded': expanded }]} aria-labelledby="services-title" data-services>
  <header class="services__head wrap" data-reveal>
    <span class="label">{SERVICES.label}</span>
    <h2 class="display" id="services-title">{SERVICES.title}</h2>
  </header>

  <div class="services__body wrap">
    <div class="services__mark" aria-hidden="true">
      <svg viewBox="0 0 100 100" class="services__svg">
        <g transform={MARK_TRANSFORM}>
          {MARK_PARTS.map((part) => (
            <path class="services__fill" d={part.d} fill={MARK_COLORS[part.tone]} />
          ))}
          {MARK_PARTS.map((part) => (
            <path class="services__line" d={part.d} pathLength="1" />
          ))}
        </g>
      </svg>
    </div>

    <ul class="services__list">
      {SERVICES.items.map((s, i) => (
        <li class:list={['service', { 'is-open': expanded }]} data-reveal style={`--reveal-delay: ${i * 0.06}s`}>
          <h3 class="service__heading">
            {expanded ? (
              <span class="service__title">{s.headline}</span>
            ) : (
              <button
                class="service__toggle"
                type="button"
                aria-expanded="false"
                aria-controls={`service-panel-${i}`}
                data-accordion
              >
                <span class="service__title">{s.headline}</span>
                <span class="service__icon"><Arrow /></span>
              </button>
            )}
          </h3>
          <p class="service__category">{s.category}</p>
          <p class="service__desc">{s.description}</p>
          <div class="service__panel" id={`service-panel-${i}`}>
            <ul class="service__details">
              {s.details.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>

  {!expanded && (
    <div class="services__more wrap">
      <Button href="/services/" variant="dark">Explore Our Services</Button>
    </div>
  )}
</section>

<style>
  .services {
    --p: 1; /* scripts/main.ts drives this with scroll; 1 = fully drawn */
    padding: var(--section-y) 0;
    background: var(--bg-light);
    color: var(--ink);
  }
  .services__head {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vh, 22px);
    margin-bottom: clamp(40px, 7vh, 90px);
  }
  .services__head .label { color: var(--ink-soft); }
  .services__head .display { max-width: 20ch; }

  .services__body {
    display: flex;
    gap: clamp(30px, 5vw, 100px);
  }
  .services__mark {
    flex: 1;
    position: relative;
  }
  .services__svg {
    position: sticky;
    top: 18vh;
    width: min(100%, 440px);
    margin: 0 auto;
    overflow: visible;
  }
  .services__line {
    fill: none;
    stroke: var(--c-mid);
    stroke-width: 0.9;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - min(1, var(--p) * 1.6));
  }
  .services__fill {
    opacity: clamp(0, (var(--p) - 0.55) * 2.6, 1);
  }

  .services__list {
    flex: 1.15;
    border-bottom: 1px solid var(--rule-light);
  }
  .services__more {
    display: flex;
    justify-content: flex-end;
    padding-top: clamp(40px, 6vh, 70px);
  }
  .services--expanded .service__title { display: block; }
  .services--expanded .service__panel { grid-template-rows: 1fr !important; }
  .service {
    display: grid;
    gap: clamp(8px, 1.2vh, 14px);
    padding: clamp(18px, 2.4vh, 28px) 0;
    border-top: 1px solid var(--rule-light);
  }
  .service__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  .service__title {
    font-size: clamp(19px, 2.1vw, 32px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.25;
    transition: color 0.3s;
  }
  .service__toggle:hover .service__title { color: var(--c-mid); }
  .service__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: clamp(34px, 3vw, 44px);
    height: clamp(34px, 3vw, 44px);
    border: 1px solid var(--rule-light);
    border-radius: 50%;
    transition: transform 0.45s var(--ease-out), background-color 0.3s, color 0.3s;
  }
  .service__toggle:hover .service__icon { background: var(--c-deep); color: var(--c-white); }
  .service__toggle[aria-expanded='true'] .service__icon { transform: rotate(90deg); }

  .service__category {
    color: var(--ink-soft);
    font-size: clamp(11px, 0.95vw, 14px);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .service__desc {
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: clamp(15px, 1.25vw, 19px);
    font-weight: 300;
    line-height: 1.5;
  }

  :global(.js) .service__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease-out);
  }
  :global(.js) .service.is-open .service__panel { grid-template-rows: 1fr; }
  .service__details {
    min-height: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 24px;
    font-size: clamp(14px, 1vw, 16px);
  }
  .service__details li {
    position: relative;
    padding-left: 18px;
  }
  .service__details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    background: var(--c-soft);
  }
  .service.is-open .service__details { padding-top: 8px; }

  @media (max-width: 1024px) {
    .services__mark { display: none; }
  }
  @media (max-width: 600px) {
    .service__details { grid-template-columns: 1fr; }
  }
</style>
