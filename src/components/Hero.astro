---
// Home opener: headline and calls to action on the left, the supporting
// line on the right, then a wide photograph and a row of capabilities.
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { HERO, CAPABILITIES } from '../data/content';
---
<section class="hero on-light" aria-labelledby="hero-title">
  <div class="hero__text wrap">
    <div class="hero__main">
      {HERO.eyebrow && <p class="label">{HERO.eyebrow}</p>}
      <h1 class="hero__title" id="hero-title">
        {HERO.title.map((seg) => (seg.mark ? <span class="accent">{seg.text}</span> : seg.text))}
      </h1>
    </div>
    <div class="hero__side">
      {HERO.intro && <p class="lead">{HERO.intro}</p>}
      <div class="hero__actions">
        <Button href="/contact/" variant="dark">Start a Project</Button>
        <Button href="/work/" variant="outline">View Our Work</Button>
      </div>
    </div>
  </div>

  <div class="hero__media wrap">
    <Image
      class="hero__img"
      src={HERO.photo.src}
      alt={HERO.photo.alt}
      widths={[640, 1024, 1440, 1920, 2560]}
      sizes="(max-width: 1360px) 92vw, 1280px"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  {CAPABILITIES.length > 0 && (
    <div class="hero__caps wrap">
      <h2 class="sr-only">What we do</h2>
      <ul class="hero__caps-list">
        {CAPABILITIES.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  )}
</section>

<style>
  .hero {
    padding: calc(var(--header-h) + clamp(48px, 8vw, 112px)) 0 clamp(56px, 7vw, 96px);
    background: var(--bg-light);
  }
  .hero__text {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: end;
  }
  .hero__main {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero__title {
    max-width: 15ch;
    font-size: var(--fs-h1);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  .hero__side {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 6px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__media {
    position: relative;
    margin-top: clamp(48px, 6vw, 88px);
    aspect-ratio: 16 / 7;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--c-dark);
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .hero__caps-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 28px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .hero__caps-list li {
    white-space: nowrap;
    color: var(--ink-soft);
    font-size: 14px;
    font-weight: 500;
  }
  .hero__caps-list li::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--c-soft);
    vertical-align: 2px;
  }

  @media (max-width: 900px) {
    .hero__text { grid-template-columns: 1fr; align-items: start; }
    .hero__caps-list { justify-content: flex-start; }
  }
  @media (max-width: 600px) {
    .hero__media { aspect-ratio: 4 / 3; }
  }
</style>
