---
// Portfolio grid: two columns of project cards. Filtering (scripts/main.ts)
// hides cards whose category doesn't match.
import ProjectCard from './ProjectCard.astro';
import { WORK } from '../data/content';
---
<section class="grid-work on-light" aria-label="Projects">
  <ul class="grid-work__list wrap" data-filter-list>
    {WORK.projects.map((p, i) => (
      <li class="grid-work__item" data-category={p.category} data-reveal style={`--reveal-delay: ${(i % 2) * 0.08}s`}>
        <ProjectCard project={p} headingLevel="h2" />
      </li>
    ))}
  </ul>
</section>

<style>
  .grid-work {
    padding: clamp(8px, 2vw, 24px) 0 var(--section-y);
    background: var(--bg-light);
  }
  .grid-work__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(48px, 6vw, 80px) clamp(24px, 3vw, 40px);
  }
  .grid-work__item[hidden] { display: none; }

  @media (max-width: 768px) {
    .grid-work__list { grid-template-columns: 1fr; }
  }
</style>
