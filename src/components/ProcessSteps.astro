---
// How we work: every step visible at once in a numbered grid, joined by a
// hairline rule along the top.
import { PROCESS } from '../data/content';

const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="psteps section-dark" aria-labelledby="psteps-title">
  <div class="wrap">
    <header class="section-head psteps__head" data-reveal>
      <span class="label">How we work</span>
      <h2 class="display" id="psteps-title">Six steps, the same on every project.</h2>
      {PROCESS.intro && <p class="lead">{PROCESS.intro}</p>}
    </header>

    <ol class="psteps__list">
      {PROCESS.steps.map((s, i) => (
        <li class="pstep" data-reveal style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
          <span class="pstep__num" aria-hidden="true">{pad(i)}</span>
          <h3 class="pstep__title">{s.name}</h3>
          <p class="pstep__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .psteps { padding: var(--section-y) 0; }
  .psteps__head { margin-bottom: clamp(48px, 6vw, 80px); }
  .psteps__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 64px) clamp(24px, 3vw, 48px);
  }
  .pstep {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
  }
  .pstep__num {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 8px;
    border: 1px solid rgba(142, 182, 155, 0.5);
    border-radius: 50%;
    color: var(--c-soft);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .pstep__title {
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .pstep__text {
    max-width: 40ch;
    color: var(--on-dark-soft);
  }

  @media (max-width: 1024px) {
    .psteps__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .psteps__list { grid-template-columns: 1fr; }
  }
</style>
