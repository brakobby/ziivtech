---
// Takes the place of the reference's client-logo wall. ZIIV does not publish
// client logos, so the section names the kinds of organisations it serves.
import { AUDIENCES } from '../data/content';
---
<section class="audiences section-dark" aria-labelledby="audiences-title">
  <header class="audiences__head wrap" data-reveal>
    <span class="label">{AUDIENCES.label}</span>
    <h2 class="display" id="audiences-title">{AUDIENCES.title}</h2>
  </header>
  <ul class="audiences__grid wrap">
    {AUDIENCES.items.map((item, i) => (
      <li class="audiences__item" data-reveal style={`--reveal-delay: ${(i % 3) * 0.08}s`}>
        <span class="audiences__index">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="audiences__name">{item.name}</h3>
        <p class="audiences__note">{item.note}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .audiences {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(48px, 8vh, 96px);
    margin-top: -1px;
    padding: clamp(80px, 12vh, 180px) 0 clamp(60px, 9vh, 120px);
  }
  .audiences__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 2vh, 22px);
    text-align: center;
  }
  .audiences__head .display { max-width: 20ch; }
  .audiences__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: clamp(24px, 3vw, 56px);
  }
  .audiences__item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: start;
    column-gap: 18px;
    row-gap: 8px;
    padding: clamp(22px, 3vh, 34px) 0;
    border-top: 1px solid var(--rule-dark);
  }
  .audiences__index {
    grid-row: span 2;
    padding-top: 0.45em;
    color: var(--c-soft);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .audiences__name {
    font-size: clamp(19px, 1.7vw, 28px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .audiences__note {
    color: var(--on-dark-soft);
    font-size: clamp(14px, 1vw, 16px);
    font-weight: 300;
  }

  @media (max-width: 1024px) {
    .audiences__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .audiences__grid { grid-template-columns: 1fr; }
  }
</style>
