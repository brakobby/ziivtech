---
// Opening block for inner pages: label, a large statement (wrap phrases in
// *asterisks* to highlight them), an optional intro line, then anything in
// the default slot (e.g. filter buttons). An optional photo runs beneath.
import { Image } from 'astro:assets';
import { highlights } from '../data/content';

interface Props {
  label: string;
  title: string;
  intro?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { label, title, intro, image, imageAlt = '' } = Astro.props;
const segments = highlights(title);
---
<section class:list={['intro on-light', { 'intro--image': image }]} aria-labelledby="page-title">
  <div class="intro__inner wrap">
    <p class="label">{label}</p>
    <h1 class="intro__title" id="page-title">
      {segments.map((seg) => (seg.mark ? <span class="accent">{seg.text}</span> : seg.text))}
    </h1>
    {intro && <p class="lead intro__lead">{intro}</p>}
    <slot />
  </div>
  {image && (
    <div class="intro__media wrap">
      <Image
        class="intro__img"
        src={image}
        alt={imageAlt}
        widths={[640, 1024, 1440, 1920, 2560]}
        sizes="(max-width: 1360px) 92vw, 1280px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}
</section>

<style>
  .intro {
    padding: calc(var(--header-h) + clamp(48px, 7vw, 104px)) 0 clamp(48px, 6vw, 80px);
    background: var(--bg-light);
    color: var(--ink);
  }
  .intro__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .intro__title {
    max-width: 22ch;
    font-size: clamp(34px, 4vw, 60px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .intro__lead { max-width: 58ch; }

  .intro__media {
    margin-top: clamp(48px, 6vw, 80px);
    aspect-ratio: 16 / 7;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--c-dark);
  }
  .intro__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .intro__media { aspect-ratio: 4 / 3; }
  }
</style>
