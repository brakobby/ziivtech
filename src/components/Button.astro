---
// Button. Renders an <a> when `href` is given, otherwise a <button>.
//   dark          : solid deep green, for light backgrounds (primary)
//   light         : solid white, for dark backgrounds (primary)
//   outline       : hairline border, for light backgrounds (secondary)
//   outline-light : hairline border, for dark backgrounds (secondary)
import Arrow from './Arrow.astro';

interface Props {
  href?: string;
  variant?: 'light' | 'dark' | 'outline' | 'outline-light';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit';
  class?: string;
  arrow?: boolean;
  [key: string]: unknown;
}
const { href, variant = 'dark', size = 'md', type = 'button', class: className, arrow, ...rest } = Astro.props;
const showArrow = arrow ?? (variant === 'dark' || variant === 'light');
const Tag = href ? 'a' : 'button';
---
<Tag
  href={href}
  type={href ? undefined : type}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...rest}
>
  <slot />
  {showArrow && <Arrow class="btn__arrow" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 50px;
    padding: 0 24px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .btn--sm {
    height: 40px;
    padding: 0 16px;
    font-size: 14px;
  }
  :global(.btn__arrow) { transition: transform 0.25s var(--ease-out); }
  .btn:hover :global(.btn__arrow),
  .btn:focus-visible :global(.btn__arrow) { transform: translateX(3px); }

  .btn--dark { background: var(--c-deep); color: var(--c-white); }
  .btn--dark:hover { background: var(--c-mid); }

  .btn--light { background: var(--c-white); color: var(--c-deep); }
  .btn--light:hover { background: var(--c-pale); }

  .btn--outline { border-color: var(--line-strong); color: var(--ink); }
  .btn--outline:hover { border-color: var(--ink); }

  .btn--outline-light { border-color: rgba(255, 255, 255, 0.3); color: var(--c-white); }
  .btn--outline-light:hover { border-color: var(--c-white); }

  .btn:disabled { opacity: 0.55; cursor: not-allowed; }
</style>
