---
// Visual for a project, filling its parent. Live projects show real
// screenshots set on a deep-green stage; the rest use their illustration.
//   frame    : desktop screenshot rising from the bottom edge (cards, lists)
//   showcase : desktop screenshot with the phone view in front (case studies)
import { Image } from 'astro:assets';
import ProjectVisual from './ProjectVisual.astro';
import type { Project } from '../data/content';

interface Props {
  project: Project;
  variant?: 'frame' | 'showcase';
  sizes?: string;
  eager?: boolean;
}
const { project: p, variant = 'frame', sizes = '(max-width: 768px) 92vw, 60vw', eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
// Without a tall capture, cards fall back to the desktop + phone pairing.
const mode = variant === 'frame' && p.shots && !p.shots.tall ? 'showcase' : variant;
---
{p.shots ? (
  <div class:list={['pm', `pm--${mode}`]}>
    <Image
      class="pm__desktop"
      src={mode === 'frame' && p.shots.tall ? p.shots.tall : p.shots.desktop}
      alt={`The ${p.name} website on desktop`}
      widths={[640, 960, 1280, 1600]}
      sizes={sizes}
      loading={loading}
    />
    {mode === 'showcase' && (
      <Image
        class="pm__mobile"
        src={p.shots.mobile}
        alt={`The ${p.name} website on mobile`}
        widths={[300, 600]}
        sizes="(max-width: 768px) 30vw, 18vw"
        loading={loading}
      />
    )}
  </div>
) : (
  <div class="pm pm--art visual-frame">
    <ProjectVisual id={p.illustration} name={p.name} />
  </div>
)}

<style>
  .pm {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(142, 182, 155, 0.18), transparent 60%),
      var(--c-dark);
  }
  .pm--art { background-color: var(--c-dark); }

  /* Frame: a tall capture sized by width, so it runs past the bottom edge
     and is cropped flush there, never at the sides */
  .pm__desktop {
    position: absolute;
    left: 8%;
    top: 9%;
    width: 84%;
    height: auto;
    border-radius: 10px 10px 0 0;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(218, 241, 222, 0.08);
    transition: transform 1s var(--ease-out);
  }

  .pm--showcase .pm__desktop {
    left: 6%;
    top: 10%;
    width: 74%;
    border-radius: 10px;
  }
  .pm__mobile {
    position: absolute;
    right: 6%;
    bottom: 8%;
    width: 18%;
    height: auto;
    border-radius: 18px;
    border: 6px solid #0a0f0e;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
  }

  @media (max-width: 768px) {
    .pm--showcase .pm__desktop { width: 82%; left: 5%; }
    .pm__mobile { width: 28%; right: 4%; border-width: 4px; border-radius: 12px; }
  }
</style>
