---
// Decorative backdrop of interlocking rounded squares, the motif ZIIV
// designed for the Agape Academy staff portal (ARMS). It fills its
// positioned parent and sits behind the content.
//   school : Agape purple with rose and lilac outlines (ARMS page)
//   ziiv   : ZIIV greens, for school-focused pages such as ZIIV Assess
//   light  : faint green outlines on a white or muted background
interface Props {
  tone?: 'school' | 'ziiv' | 'light';
  class?: string;
}
const { tone = 'school', class: className } = Astro.props;
const id = `sp-${Math.random().toString(36).slice(2, 8)}`;
const colors = {
  school: { a: '#d9375a', b: '#c8a6e8', opA: 0.55, opB: 0.28 },
  ziiv: { a: '#8eb69b', b: '#daf1de', opA: 0.32, opB: 0.16 },
  light: { a: '#235347', b: '#8eb69b', opA: 0.12, opB: 0.14 },
}[tone];
---
<svg class:list={['school-pattern', className]} aria-hidden="true" focusable="false">
  <defs>
    <pattern id={id} width="78" height="78" patternUnits="userSpaceOnUse" patternTransform="rotate(-24)">
      <rect x="10" y="10" width="26" height="26" rx="5" fill="none" stroke={colors.a} stroke-opacity={colors.opA} stroke-width="2.4" />
      <rect x="22" y="20" width="26" height="26" rx="5" fill="none" stroke={colors.b} stroke-opacity={colors.opB} stroke-width="2.4" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>

<style>
  .school-pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
