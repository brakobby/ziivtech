---
// Category tabs for the Work page. Shown only when JS is running, since
// the filtering lives in scripts/main.ts.
import { WORK_FILTERS } from '../data/content';
---
<div class="filters" role="group" aria-label="Filter projects" data-filters>
  {WORK_FILTERS.map((f, i) => (
    <button type="button" class="filter" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={f.id}>
      {f.label}
    </button>
  ))}
</div>
<p class="sr-only" role="status" data-filter-status></p>

<style>
  .filters { display: none; }
  :global(html.js) .filters {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 12px;
    padding: 4px;
    border-radius: calc(var(--radius) + 4px);
    background: var(--bg-muted);
  }
  .filter {
    height: 40px;
    padding: 0 18px;
    border: none;
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink-soft);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s;
  }
  .filter:hover { color: var(--ink); }
  .filter[aria-pressed='true'] {
    background: var(--c-white);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(5, 31, 32, 0.08), 0 0 0 1px var(--line);
  }
</style>
