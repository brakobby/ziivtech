---
// Home: selected work. Featured projects in a two-column grid, each linking
// to its case study, with a link through to the full Work page.
import ProjectCard from './ProjectCard.astro';
import Button from './Button.astro';
import { WORK } from '../data/content';

const projects = WORK.projects.filter((p) => p.featured);
---
<section class="work on-light" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <header class="work__head">
      <div class="section-head" data-reveal>
        <span class="label">{WORK.label}</span>
        <h2 class="display" id="work-title">{WORK.title}</h2>
      </div>
      <Button href="/work/" variant="outline" class="work__all">All Work</Button>
    </header>

    <ul class="work__grid">
      {projects.map((p, i) => (
        <li data-reveal style={`--reveal-delay: ${(i % 2) * 0.08}s`}>
          <ProjectCard project={p} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work {
    padding: var(--section-y) 0;
    background: var(--bg-muted);
  }
  .work__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(48px, 6vw, 80px) clamp(24px, 3vw, 40px);
  }

  @media (max-width: 768px) {
    .work__head { flex-direction: column; align-items: flex-start; }
    .work__grid { grid-template-columns: 1fr; }
  }
</style>
